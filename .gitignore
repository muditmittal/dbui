node_modules
.next
out
dist
.env
.env.local
.yarn/cache
.yarn/install-state.gz
*.tsbuildinfo
storybook-static

# Build artifacts (not distributed)
packages/dbui/tsup.config.ts
packages/dbui/design-tokens.json

# Repo-internal (force-add with git add -f)
figma.config.json
.claude/

.DS_Store

# apps/portal build artifacts (the app itself IS tracked)
apps/portal/.next/
apps/portal/node_modules/
apps/portal/storybook-static/
apps/portal/out/

# Google Drive (and similar) sync temp folders — huge file counts; keep out of repos.
.tmp.driveupload/
.tmp.drivedownload/

# Agent scratch: audit output, before/after screenshot sweeps, one-off probe scripts.
# Written during a session to reason about the system, never an input to it.
.tmp-*/

# Raw Figma dump behind the token audits. Regenerated on demand and large enough
# to bury a diff; the audits' committed output is what is worth reading.
scripts/design-lint/.figma-component-dump.json

# Storybook static build, emitted into the portal for /components
apps/portal/public/storybook/

# Computed-style snapshots from scripts/fingerprint.mjs. Megabytes each, and
# only meaningful against the running portal that produced them.
.fingerprints/

# Databricks-internal research never enters this public repo.
# Lives at ~/.cache/dbui-databricks-baseline/ — see notes/2026-08-11-design-crit-spec.md
research/databricks-baseline/

# Organizational context for design review — Databricks-internal.
# Ecosystem, review bank, raw transcripts. NEVER committed: this repo is public.
# Swappable per organization; only the contract in .context/README.md could ship.
.context/
