{
  "name": "dbui-viz",
  "version": "0.1.0",
  "description": "DBUI Viz — Vega data visualizations for Databricks UI, themed by dbui viz tokens",
  "license": "MIT",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
