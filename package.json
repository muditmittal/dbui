{
  "name": "dbui",
  "private": true,
  "version": "0.2.0",
  "description": "DBUI \u2014 an AI-first design system for data and AI workbench UIs",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./packages/dbui/src/index.ts",
    "./components/ui/*": "./packages/dbui/src/components/ui/*.tsx",
    "./components/icons/*": "./packages/dbui/src/components/icons/*.tsx",
    "./components/shells/*": "./packages/dbui-shells/src/components/*.tsx",
    "./lib/*": "./packages/dbui/src/lib/*",
    "./tokens/*": "./packages/dbui/src/tokens/*",
    "./install.md": "./packages/dbui/install.md"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace portal dev",
    "dev:dbui": "yarn workspace dbui dev",
    "build": "yarn workspace portal build",
    "build:dbui": "yarn workspace dbui build",
    "lint": "yarn workspace portal lint",
    "preview": "concurrently -n portal,storybook -c blue,magenta \"yarn dev\" \"yarn workspace portal storybook\"",
    "dbui": "node packages/dbui-cli/bin/dbui.mjs",
    "mcp": "node packages/dbui-mcp/src/server.mjs",
    "design:generate": "node scripts/design-lint/generate-tokens.mjs && node scripts/design-lint/sync-components.mjs && node scripts/generate-token-data.mjs && node scripts/generate-token-consumption.mjs && node scripts/generate-icon-data.mjs && node scripts/generate-gallery.mjs && node scripts/generate-layout-data.mjs && node scripts/generate-shell-data.mjs && node scripts/generate-utility-data.mjs",
    "design:audit": "node scripts/design-lint/verify-token-sync.mjs && node scripts/design-lint/verify-rules.mjs && node scripts/verify-spacing-scale.mjs && node scripts/verify-spelling.mjs && node scripts/design-lint/react-lint.js",
    "design:spelling": "node scripts/verify-spelling.mjs",
    "design:measure": "node scripts/audit-component-tokens.mjs && node scripts/audit-token-parity.mjs && node scripts/audit-token-orphans.mjs && node scripts/measure-dimensional-usage.mjs",
    "design:lint:react": "node scripts/design-lint/react-lint.js",
    "design:lint:shells": "node scripts/design-lint/react-lint.js packages/dbui-shells/src",
    "design:lint:figma": "node scripts/design-lint/figma-lint.js",
    "design:tokens": "node scripts/design-lint/generate-tokens.mjs",
    "design:audit-tokens": "node scripts/audit-component-tokens.mjs",
    "design:audit-figma": "node scripts/audit-figma-parity.mjs",
    "design:audit-portal": "node scripts/audit-portal-parity.mjs",
    "design:audit-tokens": "node scripts/audit-token-values.mjs",
    "design:audit-variants": "node scripts/audit-variant-parity.mjs",
    "design:audit-parity": "node scripts/audit-token-parity.mjs",
    "design:audit-orphans": "node scripts/audit-token-orphans.mjs",
    "design:sync-components": "node scripts/design-lint/sync-components.mjs",
    "design:verify-sync": "node scripts/design-lint/verify-token-sync.mjs",
    "design:verify-rules": "node scripts/design-lint/verify-rules.mjs",
    "design:verify-story-ids": "node scripts/verify-story-ids.mjs",
    "design:verify-heatmap": "node scripts/verify-heatmap-spec.mjs",
    "design:audit-viz": "node scripts/audit-viz-parity.mjs",
    "design:verify-cards": "node scripts/verify-card-render.mjs"
  },
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.2",
    "concurrently": "^9.2.1",
    "react-resizable-panels": "^4.7.3",
    "recharts": "^2.15.4"
  }
}
