{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "yarn install --no-immutable",
  "buildCommand": "cd apps/portal && npx storybook build -o public/storybook && next build",
  "outputDirectory": "apps/portal/.next",
  "redirects": [
    {
      "source": "/install.md",
      "destination": "https://raw.githubusercontent.com/muditmittal/dbui/main/packages/dbui/install.md",
      "permanent": false
    },
    {
      "source": "/docs/checks",
      "destination": "/docs/standards",
      "permanent": true
    }
  ]
}
