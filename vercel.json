{
  "buildCommand": "cd apps/portal && npx storybook build -o ../../storybook-static",
  "outputDirectory": "storybook-static",
  "installCommand": "yarn install",
  "framework": null,
  "redirects": [
    {
      "source": "/install",
      "destination": "https://raw.githubusercontent.com/muditmittal/dbui/main/packages/dbui/install.md",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
